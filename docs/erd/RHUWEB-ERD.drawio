  <diagram name="01 - Core ERD" id="page-core">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e_roles" value="<b>roles</b><br/>• id PK<br/>• slug UK (records_office, it_department,<br/>• doctor, pharmacy, system_administrator, …)<br/>• receptionist = reserved (optional queue path)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_users" value="<b>users</b><br/>• id PK<br/>• role_id FK → roles<br/>• username UK<br/>• password_hash<br/>• full_name<br/>• can_access_admin" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e_patients" value="<b>patients</b><br/>• id PK<br/>• patient_id UK<br/>• demographics (Form 1)<br/>• residential_address<br/>• status — workflow ENUM (capstone path):<br/>•   Draft → Pending IT Review → Waiting for Doctor →<br/>•   Waiting for Pharmacy → Dispensing → Dispensed →<br/>•   Ready for Printing → Printed → Archived<br/>• encoded_by FK → users<br/>• validated_by FK → users<br/>• physical_recorded" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="e_treatment_records" value="<b>treatment_records</b><br/>• id PK<br/>• patient_id FK → patients<br/>• date_of_consultation<br/>• vitals, chief_complaints<br/>• diagnosis (legacy text)<br/>• medication_treatment<br/>• healthcare_provider" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e_workflow_logs" value="<b>workflow_logs</b><br/>• id PK<br/>• patient_id FK<br/>• user_id FK<br/>• action, from_status, to_status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="180" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e_reception_queue" value="<b>reception_queue</b> (optional — not in capstone workflow)<br/>• id PK<br/>• patient_id FK → patients<br/>• consultation_id → treatment_records (optional)<br/>• queue_date, queue_number, desk_status<br/>• created_by FK → users" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e_diagnosis_master" value="<b>diagnosis_master</b><br/>• id PK<br/>• icd_code<br/>• diagnosis_name<br/>• status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
