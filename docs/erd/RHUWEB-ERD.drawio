        <mxCell id="e_consultation_diagnoses" value="<b>consultation_diagnoses</b><br/>• id PK<br/>• consultation_id → treatment_records<br/>• diagnosis_id FK → diagnosis_master" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
