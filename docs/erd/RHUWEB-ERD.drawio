        </mxCell>
        <mxCell id="e_medication_master" value="<b>medication_master</b><br/>• id PK<br/>• generic_name<br/>• brand_name, strength<br/>• status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="1">
