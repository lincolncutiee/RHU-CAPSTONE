        <mxCell id="e_Reports module (read-only)" value="<b>Reports module (read-only)</b><br/>• Common diseases chart<br/>• Cases by barangay<br/>• Trend & projection" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
