%% ============================================================
%% 2) WORKFLOW (no receptionist) — stored in patients.status + workflow_logs
%% Logic: core/Workflow.php
%% ============================================================

flowchart LR
    subgraph Records["Records Office"]
        D[Draft / Returned for Correction]
    end

    subgraph IT["IT Department"]
        IR[Pending IT Review]
        SD[Send to Doctor]
        AP[Approve for Printing]
        RP[Ready for Printing]
        PR[Printed]
        AR[Archived]
    end

    subgraph Doctor["Doctor"]
        WD[Waiting for Doctor]
    end

    subgraph Pharmacy["Pharmacy"]
        WP[Waiting for Pharmacy]
        DS[Dispensing]
        DV[Dispensed]
    end

    D -->|submit_to_it_review| IR
    D -->|IT encoding: send_to_doctor| WD
    IR -->|return_for_correction| D
    IR -->|send_to_doctor| WD
    WD -->|complete_consultation| WP
    WP -->|start_dispensing| DS
    WP -->|mark_dispensed| DV
    DS -->|mark_dispensed| DV
    DV -->|approve_for_printing| RP
    IR -->|approve_for_printing| RP
    RP -->|mark_printed| PR
    PR -->|archive_record| AR

%% ============================================================
%% 3) ANALYTICS (logical — no extra tables)
%% Reports + Heat Map read from patients + treatment_records + consultation_diagnoses
%% ReportForecast = computed projection, not persisted
%% ============================================================

flowchart TB
    P[patients] --> TR[treatment_records]
    TR --> CD[consultation_diagnoses]
    CD --> DM[diagnosis_master]
    P --> HM[Heat Map by barangay]
    TR --> RPT[Reports charts]
    CD --> RPT
    TR --> FC[Case forecast projection]
